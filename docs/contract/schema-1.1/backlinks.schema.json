        },
        "hasDdrInfo": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hasddrinfo"
        }
      },
      "title": "ContractSource",
      "type": "object"
    },
    "Generator": {
      "description": "What wrote the file. ``None`` on a file upgraded from before the contract existed.",
