    "generator": {
      "anyOf": [
        {
          "$ref": "#/$defs/Generator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/ContractSource"
    },
    "backlinks": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Backlink"
        },
        "type": "array"
      },
      "default": {},
