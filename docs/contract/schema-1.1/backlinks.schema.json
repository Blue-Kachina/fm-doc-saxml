          "title": "Sourcedocid",
          "type": "string"
        },
        "sourceEntityType": {
          "title": "Sourceentitytype",
          "type": "string"
        },
        "relationshipType": {
          "title": "Relationshiptype",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "confidence": {
          "title": "Confidence",
          "type": "string"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
