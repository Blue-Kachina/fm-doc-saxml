        "$ref": "#/$defs/ReferenceRecord"
      },
      "title": "References",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion"
  ],
  "title": "ReferencesDoc",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fm-saxml/contract/schema-1.0/references.schema.json"
