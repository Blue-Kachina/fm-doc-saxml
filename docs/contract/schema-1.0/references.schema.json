            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via"
        },
        "siteDocId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sitedocid"
        }
      },
      "required": [
        "sourceDocId",
        "sourceEntityType",
        "targetDocId",
        "targetEntityType",
        "relationshipType"
      ],
      "title": "ReferenceRecord",
      "type": "object"
    }
  },
  "description": "references.json: every reference from one entity to another.",
  "properties": {
    "schemaVersion": {
      "title": "Schemaversion",
      "type": "string"
    },
    "generator": {
      "anyOf": [
        {
          "$ref": "#/$defs/Generator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/ContractSource"
    },
    "references": {
      "default": [],
