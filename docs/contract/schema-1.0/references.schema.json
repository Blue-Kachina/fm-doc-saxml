    "ExternalTarget": {
      "description": "Everything known about a reference that points into another file.\n\nCaptured so a later multi-file run can resolve it against the sister\nfile's export: match ``uuid`` first, then ``fmp_id``, then ``name``\n(for fields: ``base_table`` + ``name``). ``data_source`` is the *name of\nthe external data source* in this file, which is a label, not necessarily\nthe target file's name — see ``DocumentModel.external_data_sources``.",
      "properties": {
        "targetDocId": {
          "default": "",
          "title": "Targetdocid",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "scopedDocId": {
          "default": "",
