<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
    <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="2" name="Get agentic-fm path">
      <Step enable="True" id="89" name="# (comment)">
        <Text>PURPOSE: Set a global variable used by other scripts to key/value pairs used by agentic-fm.</Text>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "path" ; "" ; JSONString ]
)]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$config_example</Name>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[IsEmpty ( $$AGENTIC.FM ) or JSONGetElementType ( $$AGENTIC.FM ; "" ) ≠ JSONObject]]></Calculation>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$path</Name>
      </Step>
      <Step enable="True" id="181" name="Get Folder Path">
        <AllowFolderCreation state="False"/>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <DialogTitle>
          <Calculation><![CDATA["Select the agentic-fm folder"]]></Calculation>
        </DialogTitle>
        <DefaultLocation>
          <Calculation><![CDATA[Get ( DesktopPath )]]></Calculation>
        </DefaultLocation>
        <Name>$path</Name>
      </Step>
      <Step enable="True" id="69" name="Else">
        <Restore state="False"/>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $$AGENTIC.FM ; "path" )]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$path</Name>
      </Step>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="89" name="# (comment)">
        <Text>Validate path</Text>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[$path & "fmparse.sh"]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$fmparse</Name>
      </Step>
      <Step enable="True" id="188" name="Get File Exists">
        <UniversalPathList>$fmparse</UniversalPathList>
        <Text/>
        <Field>$exists</Field>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[not $exists]]></Calculation>
      </Step>
      <Step enable="True" id="87" name="Show Custom Dialog">
        <Title>
          <Calculation><![CDATA["Invalid folder path"]]></Calculation>
        </Title>
        <Message>
          <Calculation><![CDATA["Please clear the $$AGENTIC.FM global variable and run the script again to select the agentic-fm folder."]]></Calculation>
        </Message>
        <Buttons>
          <Button CommitState="True">
            <Calculation><![CDATA["OK"]]></Calculation>
          </Button>
          <Button CommitState="False"/>
          <Button CommitState="False"/>
        </Buttons>
      </Step>
      <Step enable="True" id="103" name="Exit Script">
        <Calculation><![CDATA[False]]></Calculation>
      </Step>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONSetElement ( If ( IsEmpty ( $$AGENTIC.FM ) ; "{}" ; $$AGENTIC.FM ) ;
	[ "path" ; $path ; JSONString ]
)]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$$AGENTIC.FM</Name>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="103" name="Exit Script">
        <Calculation><![CDATA[True]]></Calculation>
      </Step>
    </Script>
    <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="3" name="Explode XML">
      <Step enable="True" id="89" name="# (comment)">
        <Text>PURPOSE: Push out solution XML to be parsed for AI use.</Text>
      </Step>
      <Step enable="False" id="61" name="Insert Text">
        <SelectAll state="False"/>
        <Text>INTERACTIVE MODE (FM Pro):&#xD;  Run with no parameter. Saves XML to desktop, POSTs to localhost:8765/explode.&#xD;  Requires companion server running and $$AGENTIC.FM configured.&#xD;&#xD;SERVER MODE (OData via AGFMScriptBridge):&#xD;  Pass JSON parameter with keys:&#xD;    repo_path     &#x2014; absolute POSIX path to the agentic-fm project root on the companion server host&#xD;    export_path   &#x2014; absolute POSIX path where FMS will write the XML export (must be host-accessible)&#xD;    companion_url &#x2014; base URL of the companion server (e.g. http://host.docker.internal:8765)&#xD;    solution_name &#x2014; (optional) override solution name; defaults to Get(FileName)&#xD;&#xD;  NOTE: export_path must be a path FMS can write to AND the companion server host can read.&#xD;  On a Linux FMS container with a host-mounted Data dir, use that mount path.&#xD;  The FM path is constructed as "filelinux:" &amp; export_path &#x2014; adjust prefix for other OS.&#xD;&#xD;RETURNS (server mode): companion server response JSON { success, exit_code, stdout, stderr }</Text>
        <Field>$README</Field>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="False" id="89" name="# (comment)">
        <Text>MARK: Server mode</Text>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation>
        </Value>
        <Name>$input</Name>
      </Step>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[JSONGetElementType ( $input ; "repo_path" ) = JSONString]]></Calculation>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $input ; "repo_path" )]]></Calculation>
        </Value>
        <Name>$repoPath</Name>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $input ; "export_path" )]]></Calculation>
        </Value>
        <Name>$exportPath</Name>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $input ; "companion_url" )]]></Calculation>
        </Value>
        <Name>$companionUrl</Name>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[Let (
	~override = JSONGetElement ( $input ; "solution_name" ) ;
	If ( IsEmpty ( ~override ) ; Get ( FileName ) ; ~override )
)]]></Calculation>
        </Value>
        <Name>$solutionName</Name>
      </Step>
      <Step enable="True" id="89" name="# (comment)">
        <Text>Build FM path: filelinux: prefix for FMS on Linux. Adjust for other OS.</Text>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA["filelinux:" & $exportPath]]></Calculation>
        </Value>
        <Name>$xmlFmPath</Name>
      </Step>
      <Step enable="True" id="3" name="Save a Copy as XML">
        <Option state="False"/>
        <UniversalPathList>$xmlFmPath</UniversalPathList>
        <Calculation><![CDATA[Get ( WindowName )]]></Calculation>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[Get ( LastError )]]></Calculation>
        </Value>
        <Name>$saveError</Name>
      </Step>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[$saveError ≠ 0]]></Calculation>
      </Step>
      <Step enable="True" id="103" name="Exit Script">
        <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "success" ; False ; JSONBoolean ] ;
	[ "error" ; "Save as XML failed (error " & $saveError & ")" ; JSONString ]
)]]></Calculation>
      </Step>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "solution_name" ; $solutionName ; JSONString ] ;
	[ "export_file_path" ; $exportPath ; JSONString ] ;
	[ "repo_path" ; $repoPath ; JSONString ]
)]]></Calculation>
        </Value>
        <Name>$payload</Name>
      </Step>
      <Step enable="True" id="160" name="Insert from URL">
        <NoInteract state="True"/>
        <DontEncodeURL state="False"/>
        <SelectAll state="True"/>
        <VerifySSLCertificates state="False"/>
        <CURLOptions>
          <Calculation><![CDATA["-X POST -H \"Content-Type: application/json\" -d " & Quote ( $payload )]]></Calculation>
        </CURLOptions>
        <Calculation><![CDATA[$companionUrl & "/explode"]]></Calculation>
        <Text/>
        <Field>$response</Field>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[Get ( LastError )]]></Calculation>
        </Value>
        <Name>$httpError</Name>
      </Step>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[$httpError ≠ 0]]></Calculation>
      </Step>
      <Step enable="True" id="103" name="Exit Script">
        <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "success" ; False ; JSONBoolean ] ;
	[ "error" ; "Companion server unreachable (error " & $httpError & ")" ; JSONString ]
)]]></Calculation>
      </Step>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="103" name="Exit Script">
        <Calculation><![CDATA[$response]]></Calculation>
      </Step>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="False" id="89" name="# (comment)">
        <Text>MARK: Interactive mode</Text>
      </Step>
      <Step enable="True" id="89" name="# (comment)">
        <Text>DEPENDENCY: The companion server must be running (agent/scripts/companion_server.py)</Text>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="1" name="Perform Script">
        <Script id="2" name="Get agentic-fm path"/>
      </Step>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[not Get ( ScriptResult )]]></Calculation>
      </Step>
      <Step enable="True" id="87" name="Show Custom Dialog">
        <Title>
          <Calculation><![CDATA["Bad install"]]></Calculation>
        </Title>
        <Message>
          <Calculation><![CDATA["The agentic-fm install was not found. Please check the $$AGENTIC.FM global variable"]]></Calculation>
        </Message>
        <Buttons>
          <Button CommitState="True">
            <Calculation><![CDATA["OK"]]></Calculation>
          </Button>
          <Button CommitState="False"/>
          <Button CommitState="False"/>
        </Buttons>
      </Step>
      <Step enable="True" id="103" name="Exit Script"/>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[Get ( DesktopPath ) & Get ( FileName ) & ".xml"]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$output</Name>
      </Step>
      <Step enable="True" id="3" name="Save a Copy as XML">
        <Option state="False"/>
        <UniversalPathList>$output</UniversalPathList>
        <Calculation><![CDATA[Get ( WindowName )]]></Calculation>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONSetElement ( "{}" ;
	[ "solution_name" ; Get ( FileName ) ; JSONString ] ;
	[ "export_file_path" ; ConvertFromFileMakerPath ( $output ; 1 ) ; JSONString ] ;
	[ "repo_path" ; ConvertFromFileMakerPath ( JSONGetElement ( $$AGENTIC.FM ; "path" ) ; 1 ) ; JSONString ] ;
	[ "exploder_bin_path" ; "~/bin/fm-xml-export-exploder" ; JSONString ]
)]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$payload</Name>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="160" name="Insert from URL">
        <NoInteract state="True"/>
        <DontEncodeURL state="False"/>
        <SelectAll state="True"/>
        <VerifySSLCertificates state="False"/>
        <CURLOptions>
          <Calculation><![CDATA["-X POST -H \"Content-Type: application/json\" -d " & Quote ( $payload )]]></Calculation>
        </CURLOptions>
        <Calculation><![CDATA["http://localhost:8765/explode"]]></Calculation>
        <Text/>
        <Field>$response</Field>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[Get ( LastError )]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$httpError</Name>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[$httpError ≠ 0]]></Calculation>
      </Step>
      <Step enable="True" id="87" name="Show Custom Dialog">
        <Title>
          <Calculation><![CDATA["Companion server not running"]]></Calculation>
        </Title>
        <Message>
          <Calculation><![CDATA["Start the companion server first:¶¶python3 agent/scripts/companion_server.py¶¶Then run Explode XML again."]]></Calculation>
        </Message>
        <Buttons>
          <Button CommitState="True">
            <Calculation><![CDATA["OK"]]></Calculation>
          </Button>
          <Button CommitState="False"/>
          <Button CommitState="False"/>
        </Buttons>
      </Step>
      <Step enable="True" id="103" name="Exit Script"/>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $response ; "success" )]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$success</Name>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $response ; "stdout" )]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$stdout</Name>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $response ; "stderr" )]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$stderr</Name>
      </Step>
      <Step enable="True" id="141" name="Set Variable">
        <Value>
          <Calculation><![CDATA[JSONGetElement ( $response ; "exit_code" )]]></Calculation>
        </Value>
        <Repetition>
          <Calculation><![CDATA[1]]></Calculation>
        </Repetition>
        <Name>$exitCode</Name>
      </Step>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="68" name="If">
        <Restore state="False"/>
        <Calculation><![CDATA[not $success or $exitCode ≠ 0]]></Calculation>
      </Step>
      <Step enable="True" id="87" name="Show Custom Dialog">
        <Title>
          <Calculation><![CDATA["Error"]]></Calculation>
        </Title>
        <Message>
          <Calculation><![CDATA[$stderr & If ( not IsEmpty ( $stdout ) ; ¶ & $stdout ; "" )]]></Calculation>
        </Message>
        <Buttons>
          <Button CommitState="True">
            <Calculation><![CDATA["OK"]]></Calculation>
          </Button>
          <Button CommitState="False"/>
          <Button CommitState="False"/>
        </Buttons>
      </Step>
      <Step enable="True" id="69" name="Else">
        <Restore state="False"/>
      </Step>
      <Step enable="True" id="87" name="Show Custom Dialog">
        <Title>
          <Calculation><![CDATA["Finished"]]></Calculation>
        </Title>
        <Message>
          <Calculation><![CDATA["The XML has been placed into agentic-fm's xml_parsed folder." & If ( not IsEmpty ( $stdout ) ; "¶¶" & $stdout ; "" )]]></Calculation>
        </Message>
        <Buttons>
          <Button CommitState="True">
            <Calculation><![CDATA["OK"]]></Calculation>
          </Button>
          <Button CommitState="False"/>
          <Button CommitState="False"/>
        </Buttons>
      </Step>
      <Step enable="True" id="70" name="End If"/>
      <Step enable="True" id="89" name="# (comment)"/>
      <Step enable="True" id="103" name="Exit Script"/>
      <Step enable="True" id="89" name="# (comment)"/>
    </Script>
</fmxmlsnippet>
